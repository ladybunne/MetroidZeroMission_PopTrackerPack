{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Lua Interpreter",
            "type": "lua-local",
            "request": "launch",
            "env": {
                "LUA_INIT": "@src/setup.lua",
            },
            "program": {
                "lua": "lua",
                "file": "${file}"
            }
        },
        {
            "name": "Busted",
            "type": "lua-local",
            "request": "launch",
            "env": {
                "LOCAL_LUA_DEBUGGER_VSCODE": "1",
                "LUA_INIT_5_4": "if os and os.getenv and os.getenv('LOCAL_LUA_DEBUGGER_VSCODE')=='1' then require('lldebugger').start() end",
                "LUA_INIT": "if os and os.getenv and os.getenv('LOCAL_LUA_DEBUGGER_VSCODE')=='1' then require('lldebugger').start() end"
            },
            "program": {
                "command": "lua_modules/bin/busted"
            },
            "cwd": "${workspaceFolder}",
            "args": [
                "--suppress-pending ${file}"
            ]
        }
    ]
}